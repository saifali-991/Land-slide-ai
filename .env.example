# NER Landslide AI — environment configuration
# Copy to .env and edit. NEVER commit real secrets.

NER_ENV=development
# Use a long random string in production (e.g. python -c "import secrets; print(secrets.token_urlsafe(48))")
NER_SECRET_KEY=change-me-to-a-long-random-string
NER_TOKEN_EXPIRE_MINUTES=1440

# Database: SQLite by default (file: database/ner_landslide.db).
# For PostgreSQL, e.g.: NER_DATABASE_URL=postgresql://user:password@localhost:5432/ner_landslide
# NER_DATABASE_URL=

# CORS origins (comma separated)
NER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Weather service (Open-Meteo — free, no API key needed)
NER_WEATHER_CACHE_TTL=600
NER_WEATHER_TIMEOUT=12

# Rate limiting (requests per minute per client IP)
NER_RATE_LIMIT_PER_MINUTE=120

# Risk model weights (auto-normalized to 100)
NER_W_RAINFALL=30
NER_W_SLOPE=20
NER_W_SOIL_MOISTURE=15
NER_W_ELEVATION=10
NER_W_SOIL_GEOLOGY=10
NER_W_LAND_COVER=5
NER_W_HISTORICAL=5
NER_W_DRAINAGE=3
NER_W_ROAD_CUTTING=2

# Risk classification thresholds (0-24 LOW, 25-49 MODERATE, 50-74 HIGH, 75-100 CRITICAL)
NER_THRESHOLD_MODERATE=25
NER_THRESHOLD_HIGH=50
NER_THRESHOLD_CRITICAL=75

# Optional ML model path override
# NER_ML_MODEL_PATH=C:/path/to/landslide_model.joblib

# Frontend (Vite) — set only if the frontend is served from a different origin.
# VITE_API_BASE_URL=http://127.0.0.1:8000
